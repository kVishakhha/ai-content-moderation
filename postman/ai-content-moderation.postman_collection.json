{
  "info": {
    "name": "AI Content Moderation - Capstone E2E",
    "description": "Gateway-based auth, messaging/moderation, and admin analytics/review checks. Set base_url, receiver_id, and image_base64 in a Postman environment. Run admin requests with an admin account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "username", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "admin_email", "value": "" },
    { "key": "admin_password", "value": "" },
    { "key": "receiver_id", "value": "" },
    { "key": "jwt_token", "value": "" },
    { "key": "jwt_admin_token", "value": "" },
    { "key": "image_base64", "value": "" },
    { "key": "image_mime_type", "value": "image/jpeg" },
    { "key": "review_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login user",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "if (body.token) pm.collectionVariables.set('jwt_token', body.token);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "if (body.token) pm.collectionVariables.set('jwt_admin_token', body.token);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Chat and moderation",
      "item": [
        {
          "name": "List conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/chat/conversations"
          }
        },
        {
          "name": "Send text (moderated by Chat Service)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": {{receiver_id}},\n  \"content\": \"Hello from the capstone E2E test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/chat/send"
          }
        },
        {
          "name": "Send warning text (creates review item)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": {{receiver_id}},\n  \"content\": \"you are ugly\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/chat/send"
          }
        },
        {
          "name": "Send image (moderation requires weapon weights)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": {{receiver_id}},\n  \"message_type\": \"image\",\n  \"image_base64\": \"{{image_base64}}\",\n  \"mime_type\": \"{{image_mime_type}}\",\n  \"content\": \"Capstone test image\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/chat/send"
          }
        }
      ]
    },
    {
      "name": "Admin analytics and review",
      "item": [
        {
          "name": "Analytics summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_admin_token}}" }],
            "url": "{{base_url}}/analytics/summary"
          }
        },
        {
          "name": "Pending warning reviews",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_admin_token}}" }],
            "url": "{{base_url}}/analytics/reviews?status=pending"
          }
        },
        {
          "name": "Confirm a warning",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"confirmed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/analytics/reviews/{{review_id}}"
          }
        }
      ]
    }
  ]
}
