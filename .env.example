# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_moderation
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Service Ports
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002
MODERATION_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
TEXT_MODEL_BACKEND=detoxify
DISTILBERT_MODEL_PATH=/artifacts/distilbert
DISTILBERT_WARN_THRESHOLD=0.30
DISTILBERT_BLOCK_THRESHOLD=0.50

# Service URLs
USER_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URL=http://localhost:3002
MODERATION_SERVICE_URL=http://localhost:3003
JSON_BODY_LIMIT=15mb
MODERATION_TIMEOUT_MS=30000
ANALYTICS_SERVICE_URL=http://localhost:3004

# Frontend (Vite build-time setting for Docker Compose)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000